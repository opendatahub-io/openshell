# CLI image for RHEL/Konflux (hermetic build).
#
# Multi-stage build that compiles the openshell CLI from source on UBI9,
# dynamically linked against glibc, so the build has no dependency on musl.
#
# The CLI must not be linked statically against glibc: a static glibc binary
# still reads the host's /etc/nsswitch.conf and dlopen()s NSS modules such as
# myhostname, resolve, systemd and sss, which pulls the host's libc.so.6 into
# the process and crashes hostname lookups (RHAI-1927). Linking dynamically
# uses the host's own libc and NSS, so host resolvers such as myhostname
# (*.localhost), resolve and sss keep working; pinning NSS the way the static
# sandbox does would drop them. The trade-off: the binary needs glibc 2.34 or
# newer on the host (RHEL 9+, Fedora, current Debian and Ubuntu) and no longer
# runs on older-glibc hosts such as RHEL 8, or on musl hosts.
#
# Requires prefetched dependencies via Hermeto (cargo, rpm, generic).
# cargo-auditable is a generic artifact so the CLI binary embeds crate
# versions for image CVE scanners. See deploy/konflux/ for prefetch configs.
#
# Local build:  ./deploy/konflux/build-local.sh cli

ARG RUST_VERSION=1.95.0

# ---------------------------------------------------------------------------
# Build stage: compile CLI (dynamically linked glibc binary)
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:25a147defd01e19674714f55d17538c8dbe55d8c305fa157ecc3f9c8977b05b6 AS builder

ARG RUST_VERSION
ARG TARGETARCH

RUN dnf install -y --nodocs \
        gcc gcc-c++ make cmake \
        openssl-devel git-core xz \
    && dnf clean all

# Extract the Rust toolchain (GNU target) and record the target triple. The
# GNU rust-std shipped with the toolchain is reused; no musl std is needed.
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    RUST_TRIPLE="${RUST_ARCH}-unknown-linux-gnu" && \
    mkdir -p /tmp/rust-toolchain && \
    tar xJf /cachi2/output/deps/generic/rust-${RUST_VERSION}-${RUST_TRIPLE}.tar.xz -C /tmp/rust-toolchain --strip-components=1 && \
    /tmp/rust-toolchain/install.sh --prefix=/usr/local && \
    rm -rf /tmp/rust-toolchain && \
    echo "RUST_TARGET=${RUST_TRIPLE}" > /tmp/build-env

# Prefetched cargo-auditable (mise.toml 0.7.5) embeds crate versions in the
# binary so image CVE scanners can report Rust advisories.
ARG CARGO_AUDITABLE_VERSION=0.7.5
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    tar xJf "/cachi2/output/deps/generic/cargo-auditable-${CARGO_AUDITABLE_VERSION}-${RUST_ARCH}-unknown-linux-gnu.tar.xz" -C /tmp && \
    install -m 0755 "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu/cargo-auditable" /usr/local/bin/cargo-auditable && \
    rm -rf "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu"

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY proto/ proto/
COPY providers/ providers/

# Scope workspace to CLI crates only -- avoids pulling in server/sandbox
# dependencies (aws-lc-sys, russh) that are unnecessary for the CLI.
RUN sed -i 's|members = \["crates/\*"\]|members = ["crates/openshell-cli", "crates/openshell-core", "crates/openshell-bootstrap", "crates/openshell-policy", "crates/openshell-prover", "crates/openshell-providers", "crates/openshell-sdk", "crates/openshell-tui"]|' Cargo.toml

# Version stamped into the binary via openshell-core::VERSION; tag builds
# pass the git tag with the leading "v" stripped. Empty otherwise.
ARG OPENSHELL_VERSION=""

# Fail the build if the binary is static: see the header for why the CLI must
# link glibc dynamically.
RUN . /tmp/build-env && \
    VER="${OPENSHELL_VERSION#v}" && \
    if [ -n "$VER" ]; then export OPENSHELL_GIT_VERSION="$VER"; fi && \
    cargo auditable build --release \
        --target "${RUST_TARGET}" \
        --package openshell-cli && \
    mkdir -p /build/output && \
    cp /build/target/${RUST_TARGET}/release/openshell /build/output/ && \
    readelf -l /build/output/openshell > /tmp/program-headers && \
    if ! grep -q 'Requesting program interpreter' /tmp/program-headers; then \
        echo "openshell must be dynamically linked against glibc" >&2; exit 1; \
    fi && \
    if ! readelf -S /build/output/openshell | grep -q '\.dep-v0'; then \
        echo "openshell is missing cargo-auditable .dep-v0 metadata" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

RUN microdnf install -y --nodocs ca-certificates crypto-policies-scripts \
    && microdnf clean all

# Enable post-quantum cryptography support in the RHEL system policy.
RUN update-crypto-policies --set DEFAULT:PQ

COPY --from=builder --chmod=0555 /build/output/openshell /usr/local/bin/openshell

LABEL com.redhat.component="odh-openshell-cli-container" \
      description="CLI for OpenShell sandboxed AI agent runtimes" \
      summary="CLI for OpenShell sandboxed AI agent runtimes" \
      name="rhoai/odh-openshell-cli-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-openshell-cli" \
      io.k8s.description="odh-openshell-cli" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/openshell"]
