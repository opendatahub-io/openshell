# Supervisor image for RHEL/Konflux (hermetic build).
#
# The supervisor runs in its own container, outside the agent workload. The
# workload-side runtime ships separately in Dockerfile.konflux.sandbox. Because
# it always runs from this image, the binary links dynamically against the
# image's glibc, the same way upstream builds it.
#
# It must not be linked statically against glibc: static glibc still dlopen()s
# the NSS modules listed in /etc/nsswitch.conf, which crashes a static binary
# (RHAI-1927).
#
# Requires prefetched dependencies via Hermeto (cargo, rpm, generic).
# cargo-auditable is a generic artifact so the supervisor binary embeds crate
# versions for image CVE scanners. See deploy/konflux/ for prefetch configs.
#
# Local build:  ./deploy/konflux/build-local.sh supervisor

ARG RUST_VERSION=1.95.0

# ---------------------------------------------------------------------------
# Build stage: compile supervisor (dynamically linked glibc binary)
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi10/ubi:10.2@sha256:9c6a62df091dd9fcef9c52ca4e10c252bdeaa0cb48b363f7e61b4c975dc75d75 AS builder

ARG RUST_VERSION
ARG TARGETARCH

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake \
        openssl-devel git-core xz \
    && dnf clean all

# Extract the Rust toolchain (GNU target) and record the target triple. The
# GNU rust-std shipped with the toolchain is reused; no musl std is needed.
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    RUST_TRIPLE="${RUST_ARCH}-unknown-linux-gnu" && \
    mkdir -p /tmp/rust-toolchain && \
    tar xJf /cachi2/output/deps/generic/rust-${RUST_VERSION}-${RUST_TRIPLE}.tar.xz -C /tmp/rust-toolchain --strip-components=1 && \
    /tmp/rust-toolchain/install.sh --prefix=/usr/local && \
    rm -rf /tmp/rust-toolchain && \
    echo "RUST_TARGET=${RUST_TRIPLE}" > /tmp/build-env

# Prefetched cargo-auditable (mise.toml 0.7.5) embeds crate versions in the
# binary so image CVE scanners can report Rust advisories.
ARG CARGO_AUDITABLE_VERSION=0.7.5
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    tar xJf "/cachi2/output/deps/generic/cargo-auditable-${CARGO_AUDITABLE_VERSION}-${RUST_ARCH}-unknown-linux-gnu.tar.xz" -C /tmp && \
    install -m 0755 "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu/cargo-auditable" /usr/local/bin/cargo-auditable && \
    rm -rf "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu"

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY proto/ proto/

# Version stamped into the binary via openshell-core::VERSION; tag builds
# pass the git tag with the leading "v" stripped. Empty otherwise.
ARG OPENSHELL_VERSION=""

# The alias re-adds `bundled-ca-roots`, which a bare `--no-default-features`
# would drop, keeping the supervisor on the same trust roots as upstream.
#
# The telemetry half is a no-op here: openshell-core/telemetry stays on
# transitively via openshell-supervisor-{network,process}, and no supervisor
# crate calls the emitter, so the endpoint is absent either way. Kept in
# lockstep with the gateway, which is where compiling telemetry out has effect.
#
# Fail the build if the binary is static: see the header for why the
# supervisor must link glibc dynamically.
RUN . /tmp/build-env && \
    VER="${OPENSHELL_VERSION#v}" && \
    if [ -n "$VER" ]; then export OPENSHELL_GIT_VERSION="$VER"; fi && \
    cargo auditable build --release \
        --target "${RUST_TARGET}" \
        --package openshell-supervisor \
        --bin openshell-supervisor \
        --no-default-features \
        --features defaults-without-telemetry && \
    mkdir -p /build/output && \
    cp /build/target/${RUST_TARGET}/release/openshell-supervisor /build/output/ && \
    readelf -l /build/output/openshell-supervisor > /tmp/program-headers && \
    if ! grep -q 'Requesting program interpreter' /tmp/program-headers; then \
        echo "openshell-supervisor must be dynamically linked against glibc" >&2; exit 1; \
    fi && \
    if ! readelf -S /build/output/openshell-supervisor | grep -q '\.dep-v0'; then \
        echo "openshell-supervisor is missing cargo-auditable .dep-v0 metadata" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:a9f9316ec3a1419a2de6ce4d2d9f034d477e97cdf2a16d6f04b7bd632ac753c4

ARG TARGETARCH

# The RHEL 10.2 DEFAULT crypto policy already enables the post-quantum ML-KEM
# hybrid key exchange groups, so the stock policy is kept as is and the
# runtime stage installs no RPMs.

# Copy the binary produced by the builder stage; it links against this image's
# glibc.
COPY --from=builder --chmod=0555 /build/output/openshell-supervisor /openshell-supervisor

LABEL com.redhat.component="odh-openshell-supervisor-container" \
      description="Sandbox supervisor for OpenShell, run outside the agent workload" \
      summary="Sandbox supervisor for OpenShell, run outside the agent workload" \
      name="rhoai/odh-openshell-supervisor-rhel10" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-openshell-supervisor" \
      io.k8s.description="odh-openshell-supervisor" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

ENTRYPOINT ["/openshell-supervisor"]
