# Gateway image for RHEL/Konflux (hermetic build).
#
# Multi-stage build that compiles openshell-gateway from source on UBI9.
# Requires prefetched dependencies via Hermeto (cargo, rpm, generic).
# cargo-auditable is a generic artifact so the gateway binary embeds crate
# versions for image CVE scanners. See deploy/konflux/ for prefetch configs.
#
# Local build:  ./deploy/konflux/build-local.sh gateway

ARG RUST_VERSION=1.95.0

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:25a147defd01e19674714f55d17538c8dbe55d8c305fa157ecc3f9c8977b05b6 AS builder

ARG RUST_VERSION
ARG TARGETARCH

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake \
        openssl-devel git-core clang-devel tar xz \
        gcc-toolset-14 gcc-toolset-14-gcc-c++ \
    && dnf clean all

# UBI9 ships rust 1.92.0, below the workspace MSRV, so install the prefetched
# upstream toolchain (GNU target) the same way the CLI and supervisor images do.
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    mkdir -p /tmp/rust-toolchain && \
    tar xJf /cachi2/output/deps/generic/rust-${RUST_VERSION}-${RUST_ARCH}-unknown-linux-gnu.tar.xz -C /tmp/rust-toolchain --strip-components=1 && \
    /tmp/rust-toolchain/install.sh --prefix=/usr/local && \
    rm -rf /tmp/rust-toolchain

# Prefetched cargo-auditable (mise.toml 0.7.5) embeds crate versions in the
# binary so image CVE scanners can report Rust advisories.
ARG CARGO_AUDITABLE_VERSION=0.7.5
RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    tar xJf "/cachi2/output/deps/generic/cargo-auditable-${CARGO_AUDITABLE_VERSION}-${RUST_ARCH}-unknown-linux-gnu.tar.xz" -C /tmp && \
    install -m 0755 "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu/cargo-auditable" /usr/local/bin/cargo-auditable && \
    rm -rf "/tmp/cargo-auditable-${RUST_ARCH}-unknown-linux-gnu"

# gcc-toolset-14 provides C++20 <format> header required by bundled Z3.
# Same pattern as ~/git/builder (AIPCC-10154).
ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-14/root/usr/lib64:/opt/rh/gcc-toolset-14/root/usr/lib \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY proto/ proto/
COPY providers/ providers/

# Version stamped into the binary via openshell-core::VERSION; tag builds
# pass the git tag with the leading "v" stripped. Empty otherwise.
ARG OPENSHELL_VERSION=""

# The alias re-adds `in-tree-compute-drivers`, which a bare
# `--no-default-features` would drop, leaving a gateway with no compute driver.

# z3-sys bundled build needs prefetched Z3 source.
ARG Z3_VERSION=4.16.0
RUN mkdir -p /tmp/z3-src \
    && tar xzf /cachi2/output/deps/generic/z3-${Z3_VERSION}.tar.gz -C /tmp/z3-src --strip-components=1 \
    && VER="${OPENSHELL_VERSION#v}" \
    && if [ -n "$VER" ]; then export OPENSHELL_GIT_VERSION="$VER"; fi \
    && Z3_SYS_BUNDLED_DIR_OVERRIDE=/tmp/z3-src \
    cargo auditable build --release \
        --package openshell-gateway \
        --no-default-features \
        --features defaults-without-telemetry,bundled-z3 && \
    if ! readelf -S /build/target/release/openshell-gateway | grep -q '\.dep-v0'; then \
        echo "openshell-gateway is missing cargo-auditable .dep-v0 metadata" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
        ca-certificates \
        crypto-policies-scripts \
    && microdnf clean all

# Enable post-quantum cryptography support in the RHEL system policy.
RUN update-crypto-policies --set DEFAULT:PQ

COPY --from=builder --chmod=0555 \
    /build/target/release/openshell-gateway \
    /usr/local/bin/openshell-gateway

LABEL com.redhat.component="odh-openshell-gateway-container" \
      description="gRPC/HTTP control-plane server for OpenShell sandboxed AI agent runtimes" \
      summary="gRPC/HTTP control-plane server for OpenShell sandboxed AI agent runtimes" \
      name="rhoai/odh-openshell-gateway-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8080:http" \
      io.k8s.display-name="odh-openshell-gateway" \
      io.k8s.description="odh-openshell-gateway" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
