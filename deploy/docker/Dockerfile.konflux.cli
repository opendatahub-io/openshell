# CLI image for RHEL/Konflux (hermetic build).
#
# Multi-stage build that compiles the openshell CLI from source on UBI10,
# dynamically linked against glibc, so the build has no dependency on musl.
#
# The CLI must not be linked statically against glibc: a static glibc binary
# still reads the host's /etc/nsswitch.conf and dlopen()s NSS modules such as
# myhostname, resolve, systemd and sss, which pulls the host's libc.so.6 into
# the process and crashes hostname lookups (RHAI-1927). Linking dynamically
# uses the host's own libc and NSS, so host resolvers such as myhostname
# (*.localhost), resolve and sss keep working; pinning NSS the way the static
# sandbox does would drop them. The trade-off: the binary needs glibc 2.38 or
# newer on the host (RHEL 10+, Fedora 39+, Debian 13+, Ubuntu 24.04+) and no
# longer runs on older-glibc hosts such as RHEL 9, or on musl hosts. On hosts
# with glibc 2.38 the loader prints a warning about the weakly linked
# GLIBC_2.39 symbols (pidfd_spawnp/pidfd_getpid). On x86_64 the binary also
# needs an x86-64-v3 CPU, because RHEL 10's GCC targets x86-64-v3 by default
# when building the C dependencies.
#
# Requires prefetched dependencies via Hermeto (cargo, rpm). The Rust
# toolchain comes from the Red Hat rust-builder image, since UBI10's
# rust-toolset is below the workspace MSRV.
# The image ships Rust 1.99.1, newer than the 1.95.0 that rust-toolchain.toml
# pins and CI tests.
# cargo-auditable is cargo-prefetched from crates.io so the CLI binary embeds
# crate versions for image CVE scanners. See deploy/konflux/cargo-auditable.
#
# Local build:  ./deploy/konflux/build-local.sh cli

# ---------------------------------------------------------------------------
# Build stage: compile CLI (dynamically linked glibc binary)
# ---------------------------------------------------------------------------
FROM registry.redhat.io/rust-builder-image/rust-rhel10:1.99.1@sha256:a416031b065e20e2eacfa1ec256657b0a9e857618675839b8a6aac99eb27de06 AS builder

# The builder image runs as 1001; cargo install needs root. It already
# ships gcc, gcc-c++, make, cmake, openssl-devel and git, so no dnf step.
USER 0

# Record the host target triple. The builder image ships only the GNU
# rust-std for the host, so no musl std is needed.
RUN echo "RUST_TARGET=$(rustc -vV | sed -n 's/^host: //p')" > /tmp/build-env

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/

# Install before the sources so application changes do not rebuild it.
# The published lock's dev-dependencies are not vendored. Strip them and pin
# the normal dependencies with the prefetch lock. Cargo reads source
# replacement from the package directory, so copy the Hermeto config there.
# Keep the version in lockstep
# with deploy/konflux/cargo-auditable/Cargo.toml.
ARG CARGO_AUDITABLE_VERSION=0.7.5
COPY deploy/konflux/cargo-auditable/Cargo.lock /tmp/cargo-auditable-prefetch.lock
RUN set -eu \
    && cp -a "/cachi2/output/deps/cargo/cargo-auditable-${CARGO_AUDITABLE_VERSION}" /tmp/cargo-auditable \
    && awk 'BEGIN { keep = 1 } /^\[dev-dependencies\./ { keep = 0 } keep' /tmp/cargo-auditable/Cargo.toml > /tmp/cargo-auditable/Cargo.toml.stripped \
    && mv /tmp/cargo-auditable/Cargo.toml.stripped /tmp/cargo-auditable/Cargo.toml \
    && grep -v -x 'resolver = "1"' /tmp/cargo-auditable/Cargo.toml > /tmp/cargo-auditable/Cargo.toml.resolver \
    && mv /tmp/cargo-auditable/Cargo.toml.resolver /tmp/cargo-auditable/Cargo.toml \
    && awk 'BEGIN { RS=""; ORS="\n\n" } /name = "konflux-prefetch-auditable"/ { next } /name = "cargo-auditable"/ { sub(/\nsource = "[^"]*"\n/, "\n"); sub(/\nchecksum = "[^"]*"\n/, "\n") } { print }' /tmp/cargo-auditable-prefetch.lock > /tmp/cargo-auditable/Cargo.lock \
    && mkdir -p /tmp/cargo-auditable/.cargo \
    && cp .cargo/config.toml /tmp/cargo-auditable/.cargo/config.toml \
    && cargo install --offline --locked --path /tmp/cargo-auditable --root /usr/local \
    && rm -rf /tmp/cargo-auditable /tmp/cargo-auditable-prefetch.lock

COPY crates/ crates/
COPY proto/ proto/
COPY tests/policy-conformance/ tests/policy-conformance/
COPY providers/ providers/

# Scope workspace to CLI crates only -- avoids pulling in server/sandbox
# dependencies (aws-lc-sys, russh) that are unnecessary for the CLI, and
# drops test-only workspace members (tests/policy-conformance) that are not
# copied into the build context.
RUN sed -i 's|^members = .*|members = ["crates/openshell-cli", "crates/openshell-core", "crates/openshell-bootstrap", "crates/openshell-policy", "crates/openshell-prover", "crates/openshell-providers", "crates/openshell-sdk", "crates/openshell-tui"]|' Cargo.toml

# Version stamped into the binary via openshell-core::VERSION; tag builds
# pass the git tag with the leading "v" stripped. Empty otherwise.
ARG OPENSHELL_VERSION=""

# Fail the build if the binary is static: see the header for why the CLI must
# link glibc dynamically.
RUN . /tmp/build-env && \
    VER="${OPENSHELL_VERSION#v}" && \
    if [ -n "$VER" ]; then export OPENSHELL_GIT_VERSION="$VER"; fi && \
    cargo auditable build --release \
        --target "${RUST_TARGET}" \
        --package openshell-cli && \
    mkdir -p /build/output && \
    cp /build/target/${RUST_TARGET}/release/openshell /build/output/ && \
    readelf -l /build/output/openshell > /tmp/program-headers && \
    if ! grep -q 'Requesting program interpreter' /tmp/program-headers; then \
        echo "openshell must be dynamically linked against glibc" >&2; exit 1; \
    fi && \
    if ! readelf -S /build/output/openshell | grep -q '\.dep-v0'; then \
        echo "openshell is missing cargo-auditable .dep-v0 metadata" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# RHEL 10 has no PQ crypto subpolicy: its stock DEFAULT policy already
# enables the post-quantum ML-KEM hybrid key exchange groups, so this stage
# does not install crypto-policies-scripts (and the Python stack it pulls).
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:f0c7b9ae9914fcf183e7c36fc46864903c2d2caf3af327421913ae54b3d29e94

RUN microdnf install -y --nodocs ca-certificates git-core \
    && microdnf clean all

# Fail the build if the stock policy stops being DEFAULT or stops enabling
# the ML-KEM hybrid groups.
RUN test "$(cat /etc/crypto-policies/config)" = "DEFAULT" \
    && grep -q MLKEM /etc/crypto-policies/back-ends/opensslcnf.config

COPY --from=builder --chmod=0555 /build/output/openshell /usr/local/bin/openshell

LABEL com.redhat.component="odh-openshell-cli-container" \
      description="CLI for OpenShell sandboxed AI agent runtimes" \
      summary="CLI for OpenShell sandboxed AI agent runtimes" \
      name="rhoai/odh-openshell-cli-rhel10" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-openshell-cli" \
      io.k8s.description="odh-openshell-cli" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 1000:1000

# Uploads need Git for repository discovery, even outside a Git work tree.
RUN git --version

ENTRYPOINT ["/usr/local/bin/openshell"]
